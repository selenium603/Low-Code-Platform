# OpenRouter 页面生成配置（提交到仓库的无密钥模板）
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.7-plus
# 可选：为“生成新页面”的布局规划阶段指定更快的模型；页面编辑链路不再使用独立 Large Planner。
AI_PLANNING_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
# 可选：上下文语义意图分类使用独立的低成本模型；未配置时在同一入口节点内使用主模型兜底。
OPENROUTER_API_KEY2=
AI_MODEL2=deepseek/deepseek-v4-flash-0731
AI_BASE_URL2=https://openrouter.ai/api/v1
# 页面生成默认关闭推理，避免模型在输出 JSON 前长时间等待。
AI_REASONING_ENABLED=false
# Stable HMAC key used to sign resumable AI edit tasks. Production deployments
# must set a long random value; local development falls back to a per-process key.
AI_PENDING_TASK_SECRET=
