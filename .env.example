# OpenRouter 页面生成配置（提交到仓库的无密钥模板）
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.7-plus
# 可选：为第一阶段指定更快的规划模型；留空时复用 AI_MODEL。
AI_PLANNING_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
# 仅 40+ 组件的大页面启用组件 RAG；Embedding 失败时自动降级为关键词 + 空间检索。
AI_RAG_ENABLED=true
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# 留空时分别复用 AI_BASE_URL 和 OPENROUTER_API_KEY。
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
# 页面生成默认关闭推理，避免模型在输出 JSON 前长时间等待。
AI_REASONING_ENABLED=false
